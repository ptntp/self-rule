#!name=Hole.io 測試改寫（參數全可在模組內編輯）
#!desc=本機攔截 remote-settings-v2.voodoo-tech.io 的 /api/settings：改寫請求的 level 與回應內容(玩法/留存/造型/時間/計分/金幣/經濟)。所有下列參數都可在 Surge「編輯參數」直接修改；複雜陣列(成長曲線/機器人分布)留在 Holeio_CoreRetention.js。僅供自己裝置測試。
#!system=ios
#!category=Gaming
#!arguments=ReportedLevel:5,LevelCompleteCoins:3000,GameDurationMinutes:15,FallingObjectScore:5,SkinsFreeNoAds:1,Gravity:-80,SuctionMultiplier:1.2,BlackHoleChaseMode:0,BlackHoleFrenzyMode:0,RewardMultiplier:1,EnergyActive:0,LivesActive:0,DailyRewardsActive:0,DailyMissionsActive:0,DailyCalendarActive:0,AdOrPayCoins:1500,CrazyPackCoins:4000,PremiumOfferCoins:1500,BuyLivesCost:900,BuyEnergyCost:900
#!arguments-desc=【等級/金幣/時間】\nReportedLevel：回報伺服器的等級(不改實際進度)\nLevelCompleteCoins：每關完成金幣(原200)\nGameDurationMinutes：每關時間/分鐘(原2)\n【玩法/計分】\nFallingObjectScore：掉落物(城牆類)得分\nGravity：重力(絕對值越大掉越快)\nSuctionMultiplier：吸力倍率(越大吸越強)\nBlackHoleChaseMode / BlackHoleFrenzyMode：黑洞追逐/狂暴模式 0或1\nRewardMultiplier：關卡獎勵倍率(1=原樣)\n【造型】\nSkinsFreeNoAds：免廣告免費解鎖造型 0或1\n【留存開關 0或1】\nEnergyActive 體力 / LivesActive 生命 / DailyRewardsActive 每日獎勵 / DailyMissionsActive 每日任務 / DailyCalendarActive 每日月曆\n【商店/經濟金額】\nAdOrPayCoins 去廣告替代獎勵 / CrazyPackCoins / PremiumOfferCoins / BuyLivesCost 買生命價 / BuyEnergyCost 買體力價

[Script]
# 同一支 .js 掛兩次：請求端改 level、回應端改 body。腳本靠有無 $response 自動分辨。
# script-path 兩種填法擇一：
#   (A) 本機：把 Holeio_CoreRetention.js 放進 iCloud 雲碟的 Surge/Scripts/ 後，用檔名參照(下方預設)。
#   (B) 線上(較穩)：把 .js 放到你自己的 GitHub/Gist raw 連結，改成該 https 網址。
HoleioReq = type=http-request,pattern=^https:\/\/remote-settings-v2\.voodoo-tech\.io\/api\/settings\?(?:[^&#]*&)*bundle_id=com\.nguyenvh\.holeio(?:&|$),script-path=Holeio_CoreRetention.js,argument="ReportedLevel={{{ReportedLevel}}}"
HoleioResp = type=http-response,pattern=^https:\/\/remote-settings-v2\.voodoo-tech\.io\/api\/settings\?(?:[^&#]*&)*bundle_id=com\.nguyenvh\.holeio(?:&|$),script-path=Holeio_CoreRetention.js,requires-body=true,max-size=1048576,argument="LevelCompleteCoins={{{LevelCompleteCoins}}}&GameDurationMinutes={{{GameDurationMinutes}}}&FallingObjectScore={{{FallingObjectScore}}}&SkinsFreeNoAds={{{SkinsFreeNoAds}}}&Gravity={{{Gravity}}}&SuctionMultiplier={{{SuctionMultiplier}}}&BlackHoleChaseMode={{{BlackHoleChaseMode}}}&BlackHoleFrenzyMode={{{BlackHoleFrenzyMode}}}&RewardMultiplier={{{RewardMultiplier}}}&EnergyActive={{{EnergyActive}}}&LivesActive={{{LivesActive}}}&DailyRewardsActive={{{DailyRewardsActive}}}&DailyMissionsActive={{{DailyMissionsActive}}}&DailyCalendarActive={{{DailyCalendarActive}}}&AdOrPayCoins={{{AdOrPayCoins}}}&CrazyPackCoins={{{CrazyPackCoins}}}&PremiumOfferCoins={{{PremiumOfferCoins}}}&BuyLivesCost={{{BuyLivesCost}}}&BuyEnergyCost={{{BuyEnergyCost}}}"

[MITM]
hostname = %APPEND% remote-settings-v2.voodoo-tech.io
