#!name=Hole.io Local Tuning - 1 / 3 / 4
#!desc=Hole.io：自訂成長、速度、體型、關卡時間與目標、經濟獎勵、開局道具及續命。只改遠端設定，不改廣告系統、購買權益或目前存檔餘額。預設不改值。
#!system=ios
#!category=Gaming
#!arguments=SpeedMultiplier:1,SizeMultiplier:1,XPMultiplier:1,GameSeconds:keep,StageSeconds:keep,ScoreGoal:keep,PercentGoal:keep,Gravity:keep,SuctionEnabled:keep,UseStageXP:keep,LevelRegistriesEnabled:keep,ForceBalanceId:keep,LevelReward:keep,RandomSkinCost:keep,BiggerCost:keep,SandglassCost:keep,FreeCoins:keep,FreeCoinsCooldownMinutes:keep,CoinsPack0:keep,CoinsPack1:keep,CoinsPack2:keep,InitialCoins:keep,InitialGems:keep,InitialBattery:keep,GemsRemoved:keep,NoAdsTimeLimited:keep,NoAdsSeconds:keep,InGameBoosters:keep,PregameBoosters:keep,BiggerUnlock:keep,SandglassUnlock:keep,BiggerInitial:keep,SandglassInitial:keep,LegacyBiggerPrice:keep,LegacySandglassPrice:keep,SandglassSeconds:keep,ContinueEnabled:keep,ContinueFreeFirst:keep,ContinueSeconds:keep,ContinueRVValue:keep,ExtraTimeEnabled:keep,ExtraSeconds:keep,SecondExtraEnabled:keep,SecondExtraSeconds:keep,SecondExtraAfterSessions:keep,LivesEnabled:keep,EnergyEnabled:keep,LifeCap:keep,EnergyCap:keep,LifeRechargeMinutes:keep,EnergyRechargeMinutes:keep,BuyLivesCost:keep,BuyEnergyCost:keep
#!arguments-desc=keep 或留空＝保留原值；倍率 1＝不變；開關填 true/false。XP 倍率越小，正數 XP 值越低。GameSeconds 同步一般與關卡時間，StageSeconds 優先。BiggerCost/SandglassCost 只改新版金幣成本，Legacy*Price 改舊版價格。Initial* 不是目前庫存。詳見 README_zh-TW.md。

# 第一項：關卡、成長、體型與速度
# SpeedMultiplier：各等級速度倍率；1 不變，1.5 為原回應的 1.5 倍。
# SizeMultiplier：各等級體型倍率；1 不變。可能影響所有讀取同一平衡表的角色，不保證只影響玩家。
# XPMultiplier：XP 表倍率；0.5 將正數 XP 減半並四捨五入，最低 1。保留 0 與負數特殊值，同時處理關卡 xpTable。
# GameSeconds：一般遊戲秒數，並同步覆寫所有既有關卡 duration；如另填 StageSeconds，關卡採 StageSeconds。關卡 duration 的秒單位仍屬依命名與上下文推定。
# StageSeconds：只覆寫所有既有關卡 duration，優先於 GameSeconds，不修改一般時間。
# ScoreGoal：覆寫現有 {Score, n} 目標；不變更目標種類，不改 Eat 目標。
# PercentGoal：覆寫現有 {Percent, n} 目標；不改 Eat 目標。
# Gravity：直接覆寫各平衡方案的重力數值；方向與效果需實機確認。
# SuctionEnabled：只改平衡方案吸力旗標；不改第五項的全域 HoleSuctionConfig，因此不保證單一旗標就能開啟吸力。
# UseStageXP：改寫已有 xpTable 與 overrideXpTable 的關卡旗標；不新增表。false 代表停用關卡專用表。
# LevelRegistriesEnabled：關卡註冊表開關；關閉可能改變遊戲流程。
# ForceBalanceId：強制現有關卡引用同一平衡方案。只接受當次回應內存在且含非空 HoleBalance 的 Id，例如 Legacy、FruitLevels、SurgeRebalanced、SurgeVariantGrowth。

# 第三項：金幣、獎勵與商店
# LevelReward：標準過關獎勵的 Coins 數值；不改獎勵 ID 對應表，也不改其他獎勵種類。
# RandomSkinCost：隨機皮膚金幣成本；保留原本 {Coins: n} 的格式。
# BiggerCost：新版變大道具的金幣成本；同步新版購買成本與商店支付表，不改舊版 PregamePrice。
# SandglassCost：新版沙漏道具的金幣成本；同步新版購買成本與商店支付表，不改舊版 PregamePrice。
# FreeCoins：免費金幣領取數量；同步 EconomyConfig 與 StoreConfig。
# FreeCoinsCooldownMinutes：免費金幣冷卻分鐘數；新版 waitTime 同步換算為秒。只是冷卻設定，不會自動發放金幣。
# CoinsPack0：內部商品 coins_0 的 Coins 獎勵數量；不會購買商品、不改售價、不授予已購權益。
# CoinsPack1：內部商品 coins_1 的 Coins 獎勵數量；不會購買商品、不改售價、不授予已購權益。
# CoinsPack2：內部商品 coins_2 的 Coins 獎勵數量；不會購買商品、不改售價、不授予已購權益。
# InitialCoins：初始化時的資源數值，不是目前帳戶餘額；既有帳戶可能完全不採用。
# InitialGems：初始化時的資源數值，不是目前帳戶餘額；既有帳戶可能完全不採用。
# InitialBattery：初始化時的資源數值，不是目前帳戶餘額；既有帳戶可能完全不採用。
# GemsRemoved：移除 Gems 模式旗標；只改此開關，不會同步遷移其他價格或帳戶資源。
# NoAdsTimeLimited：去廣告商品是否限時的設定；不是去廣告總開關，不授予購買權益，也不改廣告系統。
# NoAdsSeconds：限時去廣告方案的持續秒數；只有實際流程採用時才有意義，不授予購買權益。

# 第四項：道具、加時、續命與體力
# InGameBoosters：局內道具流程旗標；不強制開啟其他道具子功能。
# PregameBoosters：開局道具流程旗標。
# BiggerUnlock：Bigger 解鎖門檻；依 PregameBoosters 名稱尋找索引，不假設固定排列。
# SandglassUnlock：Sandglass 解鎖門檻；依 PregameBoosters 名稱尋找索引，不假設固定排列。
# BiggerInitial：Bigger 初始道具數量，不代表目前持有數量，也不修改每次購買的包裝數量。
# SandglassInitial：Sandglass 初始道具數量，不代表目前持有數量，也不修改每次購買的包裝數量。
# LegacyBiggerPrice：Bigger 舊版 PregamePrice 數值。貨幣單位未確認，因此與新版金幣成本分開設定。
# LegacySandglassPrice：Sandglass 舊版 PregamePrice 數值。貨幣單位未確認，因此與新版金幣成本分開設定。
# SandglassSeconds：沙漏加時數值；同步 SandglassTime 與對應的 PreGameDuration。
# ContinueEnabled：續命提案開關。
# ContinueFreeFirst：首次免費旗標；「首次」計數範圍未確認，不等於無限免費續命。
# ContinueSeconds：續命提案額外時間數值。
# ContinueRVValue：原始 ContinueWithRV 數值。確切語意不明，不可解讀為「看幾次廣告」或「免廣告」。
# ExtraTimeEnabled：第一段加時開關。
# ExtraSeconds：第一段加時數值。
# SecondExtraEnabled：第二段加時開關。
# SecondExtraSeconds：第二段加時數值。
# SecondExtraAfterSessions：第二段加時解鎖所需 sessions 設定值。
# LivesEnabled：生命系統開關，不修改既有存檔生命值。
# EnergyEnabled：能量系統開關，不修改既有存檔能量值。
# LifeCap：生命系統容量設定；非目前生命值。
# EnergyCap：能量系統容量設定；非目前能量值。
# LifeRechargeMinutes：生命補充間隔分鐘數。
# EnergyRechargeMinutes：能量補充間隔分鐘數。
# BuyLivesCost：新版購買生命的 Coins 成本；不改舊版 RefillCost 的 Gems 價格。
# BuyEnergyCost：新版購買能量的 Coins 成本；不改舊版 RefillCost 的 Gems 價格。

[Script]
HoleioLocalTuning = type=http-response,pattern=^https:\/\/remote-settings-v2\.voodoo-tech\.io\/api\/settings\?(?:[^&#]*&)*bundle_id=com\.nguyenvh\.holeio(?:&|$),script-path=HoleioLocalTuning.js,requires-body=true,max-size=1048576,timeout=10,debug=true,argument="SpeedMultiplier={{{SpeedMultiplier}}}&SizeMultiplier={{{SizeMultiplier}}}&XPMultiplier={{{XPMultiplier}}}&GameSeconds={{{GameSeconds}}}&StageSeconds={{{StageSeconds}}}&ScoreGoal={{{ScoreGoal}}}&PercentGoal={{{PercentGoal}}}&Gravity={{{Gravity}}}&SuctionEnabled={{{SuctionEnabled}}}&UseStageXP={{{UseStageXP}}}&LevelRegistriesEnabled={{{LevelRegistriesEnabled}}}&ForceBalanceId={{{ForceBalanceId}}}&LevelReward={{{LevelReward}}}&RandomSkinCost={{{RandomSkinCost}}}&BiggerCost={{{BiggerCost}}}&SandglassCost={{{SandglassCost}}}&FreeCoins={{{FreeCoins}}}&FreeCoinsCooldownMinutes={{{FreeCoinsCooldownMinutes}}}&CoinsPack0={{{CoinsPack0}}}&CoinsPack1={{{CoinsPack1}}}&CoinsPack2={{{CoinsPack2}}}&InitialCoins={{{InitialCoins}}}&InitialGems={{{InitialGems}}}&InitialBattery={{{InitialBattery}}}&GemsRemoved={{{GemsRemoved}}}&NoAdsTimeLimited={{{NoAdsTimeLimited}}}&NoAdsSeconds={{{NoAdsSeconds}}}&InGameBoosters={{{InGameBoosters}}}&PregameBoosters={{{PregameBoosters}}}&BiggerUnlock={{{BiggerUnlock}}}&SandglassUnlock={{{SandglassUnlock}}}&BiggerInitial={{{BiggerInitial}}}&SandglassInitial={{{SandglassInitial}}}&LegacyBiggerPrice={{{LegacyBiggerPrice}}}&LegacySandglassPrice={{{LegacySandglassPrice}}}&SandglassSeconds={{{SandglassSeconds}}}&ContinueEnabled={{{ContinueEnabled}}}&ContinueFreeFirst={{{ContinueFreeFirst}}}&ContinueSeconds={{{ContinueSeconds}}}&ContinueRVValue={{{ContinueRVValue}}}&ExtraTimeEnabled={{{ExtraTimeEnabled}}}&ExtraSeconds={{{ExtraSeconds}}}&SecondExtraEnabled={{{SecondExtraEnabled}}}&SecondExtraSeconds={{{SecondExtraSeconds}}}&SecondExtraAfterSessions={{{SecondExtraAfterSessions}}}&LivesEnabled={{{LivesEnabled}}}&EnergyEnabled={{{EnergyEnabled}}}&LifeCap={{{LifeCap}}}&EnergyCap={{{EnergyCap}}}&LifeRechargeMinutes={{{LifeRechargeMinutes}}}&EnergyRechargeMinutes={{{EnergyRechargeMinutes}}}&BuyLivesCost={{{BuyLivesCost}}}&BuyEnergyCost={{{BuyEnergyCost}}}"

[MITM]
hostname = %APPEND% remote-settings-v2.voodoo-tech.io
